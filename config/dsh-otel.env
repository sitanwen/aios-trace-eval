# DeepSeek Harness（DSH）遥测接入样例
# 采集插件：@loongsuite/dsh-plugin（进程内 OTLP/HTTP，无需 collector）
# 插件安装：dsh plugin --profile headless add @loongsuite/dsh-plugin

OTEL_SERVICE_NAME=dsh-agent
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:8080
# 平台 /v1/metrics 不落库，关闭 metrics 导出避免无效重试
OTEL_METRICS_EXPORTER=none
# 如需鉴权：OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
# 内容默认不采集；受控环境开启：OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY
# 非交互执行：dsh --profile headless "<task>"
